[{"texto": "The Americans dived into a ditch. It was a few minutes before eleven.", "perfil": "quill", "mp3": "D:/projetos/studio-dark-engine/estilos/brother_quill/assets/audio/voz_sem_marca/s29.mp3", "lang": "en"}, {"texto": "And the Germans did not shoot. They knew. The war had a few minutes left.", "perfil": "quill", "mp3": "D:/projetos/studio-dark-engine/estilos/brother_quill/assets/audio/voz_sem_marca/s30.mp3", "lang": "en"}, {"texto": "Then Henry stood up.", "perfil": "quill", "mp3": "D:/projetos/studio-dark-engine/estilos/brother_quill/assets/audio/voz_sem_marca/s31.mp3", "lang": "en"}, {"texto": "He grabbed his rifle and ran straight at the machine guns.", "perfil": "quill", "mp3": "D:/projetos/studio-dark-engine/estilos/brother_quill/assets/audio/voz_sem_marca/s32.mp3", "lang": "en"}, {"texto": "Sergeant Powell shouted at him to stop. Henry kept running.", "perfil": "quill", "mp3": "D:/projetos/studio-dark-engine/estilos/brother_quill/assets/audio/voz_sem_marca/s33.mp3", "lang": "en"}, {"texto": "Witnesses said the Germans stood up and waved at him. Go back! The war is over!", "perfil": "quill", "mp3": "D:/projetos/studio-dark-engine/estilos/brother_quill/assets/audio/voz_sem_marca/s34.mp3", "lang": "en"}, {"texto": "Henry fired a shot, maybe two. And the machine gun answered.", "perfil": "quill", "mp3": "D:/projetos/studio-dark-engine/estilos/brother_quill/assets/audio/voz_sem_marca/s35.mp3", "lang": "en"}, {"texto": "Henry Gunther was killed instantly. It was 10:59.", "perfil": "quill", "mp3": "D:/projetos/studio-dark-engine/estilos/brother_quill/assets/audio/voz_sem_marca/s36.mp3", "lang": "en"}, {"texto": "Sixty seconds later, the guns went silent along the whole Western Front.", "perfil": "quill", "mp3": "D:/projetos/studio-dark-engine/estilos/brother_quill/assets/audio/voz_sem_marca/s37.mp3", "lang": "en"}]